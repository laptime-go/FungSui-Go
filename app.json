{
  "expo": {
    "name": "風水佬Go",
    "slug": "fungsui-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.jpg",
        "backgroundColor": "#000000"
      },
      "package": "com.laptimego.fungsui",
      "versionCode": 21,
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "blockedPermissions": ["ACCESS_BACKGROUND_LOCATION"]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "1.9.22"
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access motion sensors for compass"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~8454882079"
        }
      ]
    ]
  }
}
