{
  "expo": {
    "name": "風水佬Go",
    "slug": "fungsui-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.jpg",
    "userInterfaceStyle": "dark",
    "owner": "fungfung1984",
    "splash": {
      "image": "./icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laptimego.fungsui"
    },
    "android": {
      "package": "com.laptimego.fungsui",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./icon.jpg",
        "backgroundColor": "#0f0f0f"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      ["expo-sensors"],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "用於羅盤方向",
          "locationWhenInUsePermission": "用於羅盤方向"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~8454882079",
          "iosAppId": "ca-app-pub-9890149028563226~8454882079",
          "userTrackingUsageDescription": "此識別碼用於顯示相關內容"
        }
      ]
    ],
    "extra": {
      "adUnitIds": {
        "banner": "ca-app-pub-9890149028563226/7565306387",
        "inter": "ca-app-pub-9890149028563226/5859110495",
        "appopen": "ca-app-pub-9890149028563226/1285440667",
        "native": "ca-app-pub-9890149028563226/9108090368"
      }
    }
  }
}
